# Copy this file to .env and fill in the values. Never commit .env.
# If your password has special characters (@ # / :) URL-encode them (@ -> %40).

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Read-only user (created by database/01_readonly_user.sql) on the sample database
SAMPLE_DB_URL=postgresql://copilot_ro:change_me_ro_password@localhost:5432/northwind

# App database for history (any user that can create and write tables)
APP_DB_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/copilot_app

# Safety limits
MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=10
MAX_ATTEMPTS=2
